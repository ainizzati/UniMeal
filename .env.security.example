# ============================================
# ENHANCED SECURITY CONFIGURATION FOR .env
# ============================================
# Copy these settings to your .env file for enhanced security

# Session Security Settings
SESSION_DRIVER=database          # Use database for better session management
SESSION_LIFETIME=60              # Reduced from 120 to 60 minutes
SESSION_SECURE_COOKIE=true       # Set to true in production (requires HTTPS)
SESSION_HTTP_ONLY=true           # Prevent JavaScript access to session cookie
SESSION_SAME_SITE=strict         # Strict CSRF protection (use 'lax' if needed for external redirects)
SESSION_ENCRYPT=false            # Set to true for additional security (slight performance impact)

# For local development (no HTTPS), use:
# SESSION_SECURE_COOKIE=false

# For production with HTTPS, use:
# SESSION_SECURE_COOKIE=true
